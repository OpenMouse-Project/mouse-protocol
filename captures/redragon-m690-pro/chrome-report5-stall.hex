# Redragon M690 PRO: Chrome (WebHID, Windows) over the cable: every feature read asks for wLength 0x0208 (520) instead
# of the app's 8, and the mouse STALLs it (status c0000004). Lines are HID class control transfers:
# the 8-byte setup packet, the USBD status, and any data.
setup 21 09 05 03 01 00 08 00  status 00000000  data 05 01
setup a1 01 05 03 01 00 08 02  status c0000004  data -
setup 21 09 05 03 01 00 08 00  status 00000000  data 05 01
setup a1 01 08 03 01 00 08 02  status c0000004  data -
setup 21 09 05 03 01 00 08 00  status 00000000  data 05 01
setup a1 01 05 03 01 00 08 02  status c0000004  data -
setup 21 09 05 03 01 00 08 00  status 00000000  data 05 90
setup a1 01 08 03 01 00 08 02  status c0000004  data -
setup 21 09 05 03 01 00 08 00  status 00000000  data 05 90
setup a1 01 05 03 01 00 08 02  status c0000004  data -
